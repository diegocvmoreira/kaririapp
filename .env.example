# URL base da API Laravel em produção (Hostinger kariri-api-core)
# Se estiver usando o subdomínio dedicado com rewrite, utilize https://api.kariri.app.br/api
VITE_API_BASE_URL=https://kariri.app.br/kariri-api-core/public/index.php/api

# 'true' força dados mockados locais (somente desenvolvimento). Em produção deve ser 'false'.
VITE_USE_MOCK_DATA=false

# Chave pública do widget Cloudflare Turnstile. Nunca coloque a chave secreta aqui.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACZx5Hy-3G9euZrr
