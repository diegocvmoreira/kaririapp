# URL base da API Laravel.
# Quando criar o subdomínio api.kariri.app.br, troque para https://api.kariri.app.br/api
VITE_API_BASE_URL=https://kariri.app.br/kariri-api/public/index.php/api

# 'true' força dados mockados locais (somente desenvolvimento). Em produção deve ser 'false'.
VITE_USE_MOCK_DATA=false
